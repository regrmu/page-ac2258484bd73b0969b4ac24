p:22px}\n  .client{background:#fbf6f0;border:1px solid var(--line);border-radius:4px;padding:26px 26px 28px}\n  .client h3{margin:0 0 4px;font-size:1.08rem;color:var(--brown-deep)}\n  .client .meta{font-size:12.5px;letter-spacing:.08em;color:var(--mint-deep);font-weight:700;margin:0 0 12px}\n  .client p{margin:0 0 10px;font-size:.93rem;color:#4a3126}\n  .client p:last-child{margin-bottom:0}\n  .downloads{margin-top:20px;font-size:13px;color:var(--brown-soft)}\n  .downloads a{display:inline-block;margin:4px 10px 4px 0;color:var(--brown);text-decoration:none;border-bottom:1px solid var(--mint-deep)}\n  .downloads a:hover{color:var(--mint-deep)}\n\n  /* FAQ 折叠 */\n  .faq-list{max-width:56em;display:flex;flex-direction:column;gap:12px}\n  details{background:#fbf6f0;border:1px solid var(--line);border-left:5px solid var(--brown-soft);border-radius:4px;padding:0 22px}\n  details[open]{border-left-color:var(--mint-deep);background:#fdfbf7}\n  summary{cursor:pointer;list-style:none;padding:18px 34px 18px 0;position:relative;font-weight:700;color:var(--brown-deep);font-size:1rem}\n  summary::-webkit-details-marker{display:none}\n  summary::after{content:\"+\";position:absolute;right:0;top:50%;transform:translateY(-50%);font-size:1.3rem;font-weight:500;color:var(--mint-deep);line-height:1}\n  details[open] summary::after{content:\"–\"}\n  details p{margin:0 0 18px;font-size:.94rem;color:#4a3126;max-width:46em}\n\n  /* 结尾 */\n  .closing{background:var(--brown);color:var(--paper);padding:56px 0;border-top:4px solid var(--mint)}\n  .closing h2{color:var(--mint);margin:0 0 14px}\n  .closing p{max-width:42em;margin:0 0 24px;color:rgba(244,236,227,.8);font-size:.98rem}\n  .closing .btn-solid{background:var(--mint);color:var(--brown-deep)}\n  .closing .btn-solid:hover{background:#c0efd9}\n  footer{background:var(--brown-deep);color:rgba(244,236,227,.55);font-size:13px;padding:24px 0 34px}\n  footer p{margin:0 0 6px}\n  footer a{color:rgba(244,236,227,.75);text-decoration:none;border-bottom:1px dotted rgba(244,236,227,.35)}\n\n  @media (max-width:880px){\n    .hero-grid{grid-template-columns:1fr;gap:34px}\n    .hero{padding:40px 0 48px}\n    .clients{grid-template-columns:1fr}\n    .plan ul{grid-template-columns:1fr}\n  }\n  @media (max-width:560px){\n    section.block{padding:46px 0}\n    .plan{padding:24px 20px 28px}\n    .plan-num{font-size:6.4rem;bottom:-18px}\n    .step{grid-template-columns:52px 1fr;gap:16px}\n    .step::before{font-size:1.55rem}\n    details{padding:0 16px}\n    .panel{padding:24px 20px}\n    .panel dl > div{flex-direction:column;gap:2px}\n    .panel dd{text-align:left}\n  }\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <nav class=\"crumbs\" aria-label=\"面包屑\">\n      <a href=\"#\">首页</a>\n      <span class=\"sep\">/</span>\n      <a href=\"#plans\">订阅方案</a>\n      <span class=\"sep\">/</span>\n      <span>长颈鹿使用说明</span>\n    </nav>\n    <nav class=\"dir\" aria-label=\"页面目录\">\n      <a href=\"#plans\">方案与价格</a>\n      <a href=\"#howto\">配置步骤</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#contact\">下一步</a>\n    </nav>\n  </div>\n</div>\n\n<main>\n\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <p class=\"kicker\">长颈鹿 · 订阅与使用</p>\n        <h1>长颈鹿，<br><em>先把话说清楚</em>再开始用</h1>\n        <p class=\"lede\">你在找的可能是价格，也可能是第一天的配置步骤。这一页把两件事放在一起：先看清三档方案的差别，再照着步骤把客户端跑起来，最后到问答里核对自己关心的细节。</p>\n        <p class=\"lede-secondary\">我们不堆形容词。方案按流量和同时在线设备数分档，步骤按顺序写，问题按真实疑问排列。</p>\n        <div class=\"hero-actions\">\n          <a class=\"btn btn-solid\" href=\"#plans\">查看三档方案</a>\n          <a class=\"btn btn-ghost\" href=\"#howto\">直接看配置步骤</a>\n        </div>\n      </div>\n\n      <aside class=\"panel\">\n        <h2 id=\"panel-title\">一页速览</h2>\n        <p class=\"panel-note\">以下信息与下方正文一致，可作对照。</p>\n        <dl>\n          <div><dt>方案数量</dt><dd>3 档</dd></div>\n          <div><dt>起步月付</dt><dd>¥15 / 月</dd></div>\n          <div><dt>年付方式</dt><dd>按年一次付清</dd></div>\n          <div><dt>设备上限</dt><dd>3 / 5 / 20 台</dd></div>\n          <div><dt>流量档位</dt><dd>100 / 300 / 1000GB</dd></div>\n          <div><dt>支持渠道</dt><dd>工单</dd></div>\n        </dl>\n        <p class=\"panel-foot\">年付价格是月付十个月的量，不额外赠送时长。具体可用性与线路情况以你实际购买时页面显示为准。</p>\n      </aside>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-tag\">方案</p>\n        <h2>三档订阅，差别在流量与设备数</h2>\n        <p>从下往上读：先用基础版判断是否合用，再决定要不要升到旗舰版或团队版。三档都支持年付，年付金额一次付清。</p>\n      </div>\n\n      <div class=\"plans\">\n\n        <article class=\"plan\">\n          <span class=\"plan-num\">01</span>\n          <div class=\"plan-head\">\n            <h3>基础版</h3>\n            <span class=\"price\">¥15<span> / 月</span></span>\n          </div>\n          <p class=\"annual\">按年付 ¥150 / 年，相当于十个月的价格。</p>\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan featured\">\n          <span class=\"plan-num\">02</span>\n          <div class=\"plan-head\">\n            <h3>旗舰版</h3>\n            <span class=\"badge\">多数人选这档</span>\n            <span class=\"price\">¥35<span> / 月</span></span>\n          </div>\n          <p class=\"annual\">按年付 ¥350 / 年，相当于十个月的价格。</p>\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <span class=\"plan-num\">03</span>\n          <div class=\"plan-head\">\n            <h3>团队版</h3>\n            <span class=\"price\">¥85<span> / 月</span></span>\n          </div>\n          <p class=\"annual\">按年付 ¥850 / 年，相当于十个月的价格。</p>\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n\n      </div>\n\n      <p class=\"plans-foot\">流量按月清零，不结转；同时在线数按设备计，同一账号多端登录会占用名额。定制路由与专属服务需要在下单前与客服确认可行性，不是所有场景都能落地。</p>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-tag\">流程</p>\n        <h2>从下单到能正常访问，四步</h2>\n        <p>不需要先研究一堆术语。按顺序做，中途卡住就回来看第三、四步。</p>\n      </div>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div>\n            <h3>选一档方案并完成支付</h3>\n            <p>先估计每月大概用多少流量、需要几台设备同时在线。拿不准就从基础版开始，之后可以升级，差额按实际规则补。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div>\n            <h3>拿到订阅信息，妥善保存</h3>\n            <p>支付完成后你会得到账号与订阅相关信息。请存到一个自己能找回来的地方，不要直接截图发在公开群里。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div>\n            <h3>在设备上安装客户端</h3>\n            <p>按你的系统选择对应客户端，见下方「客户端」一节。若你的设备不在列表内，先确认系统版本，再问客服能否支持。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div>\n            <h3>导入并测试</h3>\n            <p>导入订阅后先打开一个常用网站做测试，再逐个打开你真正需要的应用。若某个应用不通，先换线路再排查客户端设置。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-tag\">客户端</p>\n        <h2>各平台大致用哪一类客户端</h2>\n        <p>下面是按系统归类的常见做法，具体界面以你安装的版本为准。我们不提供来路不明的安装包，下载请走系统应用商店或客户端项目的官方渠道。</p>\n      </div>\n\n      <div class=\"clients\">\n\n        <article class=\"client\">\n          <h3>Windows 桌面</h3>\n          <p class=\"meta\">桌面端 · 需手动导入</p>\n          <p>建议使用带系统代理开关的桌面客户端，导入订阅后开启系统代理即可。首次使用时记得允许程序通过防火墙。</p>\n          <p>如果浏览器能开但其他软件不行，多半是系统代理没有覆盖到，检查客户端里的代理模式设置。</p>\n          <p class=\"downloads\">下载地址：<a href=\"#\">以官方项目页面为准</a></p>\n        </article>\n\n        <article class=\"client\">\n          <h3>macOS</h3>\n          <p class=\"meta\">桌面端 · 注意权限提示</p>\n          <p>macOS 首次运行需要批准网络扩展权限，按系统提示在设置里允许即可。若跳过这一步，客户端看起来在运行但实际不生效。</p>\n          <p>多显示器或长时间待机后出现异常，退出客户端再重新打开通常就能恢复。</p>\n          <p class=\"downloads\">下载地址：<a href=\"#\">以官方项目页面为准</a></p>\n        </article>\n\n        <article class=\"client\">\n          <h3>Android</h3>\n          <p class=\"meta\">移动端 · 注意电池优化</p>\n          <p>安装后导入订阅，连接时系统会请求建立 VPN 连接，点允许。部分机型需要把这个应用加入电池优化白名单，否则后台会被清理。</p>\n          <p>同时在线设备数按端计算，手机和平板分别占一个名额。</p>\n          <p class=\"downloads\">下载地址：<a href=\"#\">以官方项目页面为准</a></p>\n        </article>\n\n        <article class=\"client\">\n          <h3>iOS / iPadOS</h3>\n          <p class=\"meta\">移动端 · 走应用商店</p>\n          <p>请在 App Store 内搜索并安装对应客户端，再用订阅信息导入。安装后第一次连接需要在系统弹窗中确认添加配置。</p>\n          <p>换区下载需要你自己已有的账号，我们不提供账号或代下服务。</p>\n          <p class=\"downloads\">下载地址：<a href=\"#\">以 App Store 页面为准</a></p>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-tag\">常见问题</p>\n        <h2>你大概会问这些</h2>\n        <p>点开每一条展开答案。如果这里没有你要的问题，直接发工单更省时间。</p>\n      </div>\n\n      <div class=\"faq-list\">\n\n        <details>\n          <summary>三档方案到底该选哪一档？</summary>\n          <p>只看两个数字：每月流量和设备数。一个人日常用、偶尔看视频，基础版的 100GB 与 3 台设备通常够；家里有几台设备、有看流媒体和打游戏的需求，旗舰版的 300GB 与 5 台设备更宽裕；需要多人共用或给团队配，再看团队版。</p>\n        </details>\n\n        <details>\n          <summary>年付比月付省多少？</summary>\n          <p>三档的年付都是月付十个月的金额：基础版 ¥150 / 年、旗舰版 ¥350 / 年、团队版 ¥850 / 年。年付一次付清，不额外赠送时长，也不按月分摊。</p>\n        </details>\n\n        <details>\n          <summary>流量当月用不完会留到下个月吗？</summary>\n          <p>不会。流量按月计算，当月未用完的部分不结转。出现流量提前用完的情况，可以先看客户端里的统计，确认是否是某些应用在后台大量传输。</p>\n        </details>\n\n        <details>\n          <summary>同时在线设备数是怎么算的？</summary>\n          <p>按设备计，不是按人计。手机、平板、电脑各自占一个名额，超出上限时新设备会连不上，需要先断开一台。基础版 3 台、旗舰版 5 台、团队版 20 台。</p>\n        </details>\n\n        <details>\n          <summary>买了基础版之后想升级怎么办？</summary>\n          <p>可以升到更高档位，具体补差规则以购买时的页面说明为准。升级前建议先确认自己的实际需求，避免升上去之后又用不满。</p>\n        </details>\n\n        <details>\n          <summary>为什么某个应用能用，另一个不行？</summary>\n          <p>这通常和客户端的代理模式有关：有的模式只接管浏览器流量，不覆盖其他程序。先检查客户端的代理开关是否作用于整个系统，再考虑换线路。</p>\n        </details>\n\n        <details>\n          <summary>连接后网速不理想，先查什么？</summary>\n          <p>按顺序来：先换一条线路再测，然后确认本地网络本身是否正常，最后看设备是否在后台跑下载或更新。三档方案在节点池上有区别，档位不同可选的线路也不同。</p>\n        </details>\n\n        <details>\n          <summary>遇到问题怎么联系？</summary>\n          <p>通过工单提交，写清楚设备系统、客户端名称与版本、出问题的具体表现和大概时间。旗舰版有 7×24 优先工单支持，团队版另有专属客户经理对接，其余档位按普通工单处理。</p>\n        </details>\n\n        <details>\n          <summary>团队版的定制路由一定能做吗？</summary>\n          <p>不一定。定制路由需要在下单前沟通具体场景和规模，由我们判断能否实现，不能实现的部分会提前说明，不做无法兑现的承诺。</p>\n        </details>\n\n      </div>\n    </div>\n  </section>\n\n  <section class=\"closing\" id=\"contact\">\n    <div class=\"wrap\">\n      <h2>看完了，下一步做什么</h2>\n      <p>先在方案里挑一档，再照着四步配置。如果你还有拿不准的地方，提交工单时把你的系统和使用场景写清楚，会比反复问「能不能用」更快得到有效回复。</p>\n      <a class=\"btn btn-solid\" href=\"#plans\">回到方案列表</a>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <p>长颈鹿 · 订阅方案与使用说明</p>\n    <p>价格与权益以购买时页面显示为准；客户端请通过官方渠道获取。返回<a href=\"#\">页面顶部</a>。</p>\n  </div>\n</footer>",
